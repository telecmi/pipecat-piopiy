# --- Piopiy (from the dashboard) ---
PIOPIY_AGENT_ID=14ec3fc5-8e6c-4bc6-bdca-d52b0f24a201
PIOPIY_TOKEN=eyJhbGciOi...
# optional: REST base override (default https://rest.piopiy.com/v3) and register
# PIOPIY_API_URL=https://rest.piopiy.com/v3
# PIOPIY_REGISTER=register.piopiy.com
# where transfer_call sends the caller, and the number the human sees (one of your Piopiy numbers)
PIOPIY_TRANSFER_NUMBER=919876543210
PIOPIY_CALLER_ID=911203134087
# calls this process handles at once
PIOPIY_MAX_SESSIONS=10

# --- your services ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_VOICE=aura-2-thalia-en

# --- 02_piopiy_gemini_live.py (speech-to-speech) ---
GOOGLE_API_KEY=
# GEMINI_MODEL=            # leave unset for Pipecat's current default native-audio model
GEMINI_VOICE=Charon        # Puck, Charon, Kore, Fenrir, Aoede, ...
# GEMINI_LANGUAGE=         # leave unset: the native-audio model detects the language itself
                           # (Hindi, Tamil, English... in one call). Codes like en-IN are rejected.
